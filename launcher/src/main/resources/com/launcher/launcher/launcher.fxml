<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.layout.FlowPane?>

<?import javafx.scene.control.Button?>
<VBox alignment="TOP_LEFT" spacing="20.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.launcher.launcher.LauncherController" styleClass="root">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <Label fx:id="Launch"/>
    <Button text="Tower Game" onAction="#onLaunchButtonClick" styleClass="launch-button">
        <graphic>
            <ImageView fitWidth="220" fitHeight="70" preserveRatio="true" fx:id="IconImage">
            </ImageView>
        </graphic>
    </Button>

    <Button text="ADD GAME" onAction="#onAddGame" styleClass="add-button"> </Button>
    <FlowPane fx:id="gameList" hgap="10" vgap="10"/>
</VBox>
